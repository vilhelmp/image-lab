# Copy to ..\.env, one folder ABOVE the repository, so a secret can never be committed by accident.
# Set ENV_FILE to use another path. Values already in the environment (shell, Space secrets) win.
# Only the variables named below are read from the file. Blank values are ignored.
# DEVELOPMENT_MODE=true uses fakes, needs no keys and disables login. Never set it on a Space.
DEVELOPMENT_MODE=

# Only the selected image_backend's key is required (fal -> FAL_KEY, hf -> HF_TOKEN).
FAL_KEY=
HF_TOKEN=
OPENAI_API_KEY=

# Required when access.enabled is true. Use long random values (>= 20 characters, different).
# In development mode, setting both turns login on so you can try it with fakes.
WORKSHOP_PASSWORD=
ADMIN_PASSWORD=

# Only while running scripts/load_test.py: lets the Gradio client call events. Set it in the shell
# or as a Space variable, not in the .env file (it is not read from there).
EXPOSE_API=
