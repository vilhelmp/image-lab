# Copy to .env for local development. Never commit .env.
# DEVELOPMENT_MODE=true uses fakes, needs no keys and disables login. Never set it on a Space.
DEVELOPMENT_MODE=

# Only the selected image_backend's key is required (fal -> FAL_KEY, hf -> HF_TOKEN).
FAL_KEY=
HF_TOKEN=
OPENAI_API_KEY=

# Required when access.enabled is true. Use long random values (>= 20 characters).
WORKSHOP_PASSWORD=
ADMIN_PASSWORD=
